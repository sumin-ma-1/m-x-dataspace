@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <urn:mx:etri-aiot:> .

# Core, reusable constraints (dataset-agnostic as much as possible)
# - required fields
# - cardinality
# - datatypes

ex:OperationRecordCoreShape
  a sh:NodeShape ;
  sh:targetClass ex:OperationRecord ;

  sh:property [
    sh:path ex:time ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:dateTime ;
  ] ;
  sh:property [
    sh:path ex:operationId ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path ex:controlS ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:decimal ;
  ] ;
  sh:property [
    sh:path ex:controlF ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:decimal ;
  ] ;
  sh:property [
    sh:path ex:toolPosX ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:decimal ;
  ] ;
  sh:property [
    sh:path ex:toolPosY ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:decimal ;
  ] ;
  sh:property [
    sh:path ex:toolPosZ ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:decimal ;
  ] ;
  sh:property [
    sh:path ex:spindleCurrentU ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:decimal ;
  ] ;
  sh:property [
    sh:path ex:spindleCurrentV ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:decimal ;
  ] ;
  sh:property [
    sh:path ex:statusLabel ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
  ] .


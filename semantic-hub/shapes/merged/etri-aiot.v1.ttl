@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <urn:mx:etri-aiot:> .

# Merged shape file for execution convenience
# (core + profile: etri-aiot/v1)

ex:OperationRecordCoreShape
  a sh:NodeShape ;
  sh:targetClass ex:OperationRecord ;

  sh:property [ sh:path ex:time ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:dateTime ] ;
  sh:property [ sh:path ex:operationId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path ex:controlS ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
  sh:property [ sh:path ex:controlF ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
  sh:property [ sh:path ex:toolPosX ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
  sh:property [ sh:path ex:toolPosY ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
  sh:property [ sh:path ex:toolPosZ ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
  sh:property [ sh:path ex:spindleCurrentU ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
  sh:property [ sh:path ex:spindleCurrentV ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
  sh:property [ sh:path ex:statusLabel ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

ex:OperationRecordProfileEtriV1Shape
  a sh:NodeShape ;
  sh:targetClass ex:OperationRecord ;
  sh:property [ sh:path ex:controlS ; sh:minInclusive 0.0 ; sh:maxInclusive 2202.0 ] ;
  sh:property [ sh:path ex:controlF ; sh:minInclusive 0.0 ; sh:maxInclusive 54600.0 ] ;
  sh:property [ sh:path ex:toolPosX ; sh:minInclusive -168.0 ; sh:maxInclusive 52.0 ] ;
  sh:property [ sh:path ex:toolPosY ; sh:minInclusive -91.0 ; sh:maxInclusive 250.521 ] ;
  sh:property [ sh:path ex:toolPosZ ; sh:minInclusive 0.0 ; sh:maxInclusive 189671.0 ] ;
  sh:property [ sh:path ex:spindleCurrentU ; sh:minInclusive 0.0 ; sh:maxInclusive 50.0 ] ;
  sh:property [ sh:path ex:spindleCurrentV ; sh:minInclusive 0.0 ; sh:maxInclusive 99.98 ] ;
  sh:property [ sh:path ex:statusLabel ; sh:in ( "0"^^xsd:string "201"^^xsd:string "202"^^xsd:string ) ] .


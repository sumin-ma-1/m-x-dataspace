# syntax=docker/dockerfile:1
#
# EDC Data Dashboard UI container for local demo.
# Source: https://github.com/eclipse-edc/DataDashboard
#
# This image builds the upstream dashboard and injects local nginx/config
# to route UI calls to consumer/provider connectors in this compose network.

FROM node:22-alpine AS builder
WORKDIR /src
RUN apk add --no-cache git
RUN git clone --depth 1 https://github.com/eclipse-edc/DataDashboard.git .
COPY docker/ui/overlay/ /overlay/
RUN cp -r /overlay/* /src/
RUN npm ci
RUN npm run lib-build -- --configuration production
RUN npm run build -- --configuration production

FROM nginxinc/nginx-unprivileged:1.27.4-alpine3.21-slim
COPY --from=builder /src/dist/data-dashboard/browser /app
COPY docker/ui/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/ui/config/ /app/config/
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
